# AutoRecon environment settings
# Copy this file to .env and fill in your values:   cp .env.sample .env
# Or keep it anywhere and point to it with an absolute path (file or directory):
#   ./AutoRecon.sh ... -e /path/to/.env      or   export AUTORECON_ENV_FILE=/path/to/dir
# Lookup order: ./.env, then -e / $AUTORECON_ENV_FILE, then <AutoRecon.sh dir>/.env.
# The first file that sets a variable wins; variables exported in your shell beat all files.

# NVD API key for the CVE lookup in Recon (free: https://nvd.nist.gov/developers/request-an-api-key)
# Without it NVD allows 5 requests / 30s (6s wait per request); with it, 50 requests / 30s.
NVD_API_KEY=
